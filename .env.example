# Copy to .env.local and fill in. Never commit real values.
# Neon: Project > Connection details > pooled connection string
DATABASE_URL=
# Google AI Studio API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried in order when the main model is overloaded or too slow
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Resend API key, and the address emails are sent from
RESEND_API_KEY=
EMAIL_FROM=Clear2Ship <onboarding@resend.dev>
# Who gets the 48-hour admin alert
ADMIN_EMAIL=
# Optional: seller email put on the 3 sample shipments
SAMPLE_SELLER_EMAIL=
# Link used in emails
APP_URL=http://localhost:3100
# Protects /api/cron/reminders (Vercel sends it automatically when set)
CRON_SECRET=
# Where requests are emailed. One address per carrier (falls back to CARRIER_EMAIL). example.test never delivers.
CARRIER_A_EMAIL=carrier-a@example.test
CARRIER_B_EMAIL=carrier-b@example.test
CARRIER_C_EMAIL=carrier-c@example.test
CARRIER_EMAIL=
WAREHOUSE_EMAIL=warehouse@example.test
# Gets the seller's replies to customs
FORWARDER_EMAIL=forwarder@example.test
# Signs the action links in alert emails / Telegram (any long random string)
ACTION_LINK_SECRET=
# Telegram bot for seller alerts (create with @BotFather)
TELEGRAM_BOT_TOKEN=
